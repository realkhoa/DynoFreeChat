{
  "name": "dynofreechat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom",
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry",
      },
      {
        "name": "GARDEN",
        "class_name": "Garden",
      },
      {
        "name": "GARDEN_HUB",
        "class_name": "GardenHub",
      },
      {
        "name": "MARKET",
        "class_name": "MarketBoard",
      },
      {
        "name": "BOT_MANAGER",
        "class_name": "BotManager",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom", "Registry"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Garden", "GardenHub"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MarketBoard"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["BotManager"],
    },
  ],
  "triggers": {
    // Bots settle every elapsed farm cycle, so ten minutes still settles two
    // cycles per tick while halving the Durable Object requests the cron bills.
    "crons": ["*/10 * * * *"],
  },
  "vars": {
    "ALLOWED_ORIGINS": "localhost,https://realkhoa.github.io",
  },
}
