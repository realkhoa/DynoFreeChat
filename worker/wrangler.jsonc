{
  "name": "dynofreechat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom",
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry",
      },
      {
        "name": "GARDEN",
        "class_name": "Garden",
      },
      {
        "name": "GARDEN_HUB",
        "class_name": "GardenHub",
      },
      {
        "name": "MARKET",
        "class_name": "MarketBoard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom", "Registry"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Garden", "GardenHub"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MarketBoard"],
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "localhost,https://realkhoa.github.io",
  },
}
